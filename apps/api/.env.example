# Optional: otherwise the API reads the dedicated local setup from .local/database.json.
DATABASE_URL=postgresql://traceboard_app:YOUR_PASSWORD@127.0.0.1:55432/traceboard
TEST_DATABASE_URL=postgresql://traceboard_app:YOUR_PASSWORD@127.0.0.1:55432/traceboard_test
PORT=4000
HOST=127.0.0.1
TRACEBOARD_STORAGE=postgres
TRACEBOARD_API_TOKEN=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Optional: enables POST /api/ai/generate-flow. Free token from https://huggingface.co/settings/tokens (read access is enough).
# Without it, the rest of the API works the same; that endpoint replies 503.
HF_API_TOKEN=
# Optional: defaults to a small free-tier instruct model. Hugging Face's free model availability changes over time;
# verify the model is still served by Inference Providers' free tier under your account before relying on it.
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
